# TidyMail Environment Variables
# Copy this file to `.env` and fill in values:
#   cp .env.example .env
# Then edit .env — NEVER commit .env to git (it is already in .gitignore)
#
# To generate random secret strings, use:
#   openssl rand -hex 32   (for 32-byte / 256-bit secrets)
#   openssl rand -hex 16   (for 16-byte / 128-bit salts)
#
# How this file is loaded:
#   The `me.paulschwarz:spring-dotenv` library reads .env at startup and maps
#   keys (e.g. GOOGLE_CLIENT_ID) directly into the Spring Environment so you
#   can reference them in application.properties as ${GOOGLE_CLIENT_ID}.
#   Alternatively, any value here can also be set as a real OS environment
#   variable or passed via SPRING_APPLICATION_JSON on the command line.

# =========================================================================
# 1. APPLICATION BASIC
# =========================================================================

# Active Spring profile. Use "dev" locally, "prod" when deployed behind
# Cloudflare Tunnel.
SPRING_PROFILES_ACTIVE=dev

# Server port the Spring Boot embedded Tomcat listens on. When running
# behind Cloudflare Tunnel, cloudflared points at localhost:8080.
SERVER_PORT=8080

# Public base URL of the application.
#   DEV:  http://localhost:8080
#   PROD: https://tidymail.yourdomain.com  (your Cloudflare HTTPS URL)
# IMPORTANT: This value must MATCH the redirect-URI "Authorized" origin you
# configure in Google Cloud Console and Azure App Registration (see section 3
# and 4 below). Changing it after OAuth is configured means re-configuring
# both providers.
APP_BASE_URL=http://localhost:8080

# Display name shown in the UI, page titles, email subjects, etc.
APP_NAME=TidyMail

# Human-readable description of the current environment, shown in the
# footer and admin diagnostics page (dev-only). Not a secret.
APP_ENVIRONMENT_DESCRIPTION="Local development"

# =========================================================================
# 2. DATABASE (PostgreSQL)
# =========================================================================
# TidyMail requires PostgreSQL 14+. Works with:
#   - Local Docker Postgres (see command below)
#   - Neon, Supabase, Tembo, or any managed Postgres (paste the full JDBC URL)
#
# Local Docker quick start (one-liner — uses repo's docker-compose.yml):
#   docker compose up -d
#
# The postgres:16-alpine entrypoint auto-creates user, password, and database
# from the POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB env vars declared
# in docker-compose.yml, so no manual CREATE DATABASE step is needed.
# Verify readiness with:
#   docker compose logs -f tidymail-db | grep "database system is ready"

# JDBC connection string. For managed Postgres (Neon/Supabase/Tembo) copy the
# provider's JDBC URL verbatim — it usually includes user/password inline and
# has ?sslmode=require appended.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tidymail

# Database username. Defaults match `docker-compose.yml` environment variables
# (POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB).  For the local Postgres
# started with `docker compose up -d` in this repo, leave these as-is.
SPRING_DATASOURCE_USERNAME=tidymail

# Database password. For managed Postgres this may be embedded in the JDBC
# URL (in which case you can leave this blank), but it is safer to set it
# explicitly here.  Default matches docker-compose POSTGRES_PASSWORD value.
SPRING_DATASOURCE_PASSWORD=tidymaildev

# Hibernate DDL strategy.  ALWAYS "validate" for TidyMail regardless of
# profile: Flyway is the single source of truth for schema evolution and runs
# on boot when `--spring.flyway.enabled=true` is passed or the env var is set.
# Hibernate validate then double-checks that entity metadata matches the
# applied Flyway schema — any drift throws an IllegalStateException BEFORE any
# request is served (same pattern as CryptoStartupValidator for env vars).
# Using "update" / "create-drop" here is rejected: it silently overrides
# Flyway, issues OID / ALTER side-effects on PostgreSQL BYTEA columns, and
# defeats the plan's schema-migration audit trail.
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Whether Hibernate logs every SQL statement to stdout. Noise level: extreme.
# Leave "false" unless actively debugging ORM queries.
SPRING_JPA_SHOW_SQL=false

# =========================================================================
# 3. GOOGLE OAUTH (Gmail)
# =========================================================================
# HOW TO GET THESE VALUES:
#   1. Go to https://console.cloud.google.com/
#   2. Create a project (or reuse an existing personal one).
#   3. APIs & Services → Enable APIs → enable "Gmail API".
#   4. APIs & Services → OAuth consent screen:
#        - User type = External (testing is fine for personal use)
#        - App name = TidyMail
#        - Add yourself as a Test User (critical — otherwise login is blocked)
#   5. APIs & Services → Credentials → Create Credentials →
#      OAuth 2.0 Client ID → Application type = Web application.
#   6. Under "Authorized redirect URIs" ADD THIS EXACT URI:
#        ${APP_BASE_URL}/login/oauth2/code/google
#      (e.g. http://localhost:8080/login/oauth2/code/google for dev, or
#       https://tidymail.yourdomain.com/login/oauth2/code/google for prod)
#      You can add BOTH at the same time — Google supports multiple.
#   7. Save. Copy the Client ID and Client Secret into the two vars below.
#
# NOTE: Scopes (openid, profile, email, gmail.modify, offline_access) are
# defined statically in application.properties, not here. This file only
# holds the secret credentials.

# OAuth 2.0 Client ID, looks like:
#   1234567890-abcdef123456.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# OAuth 2.0 Client Secret — a short random string Google shows ONCE during
# creation. If you lose it, delete the credential and create a new one.
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -------------------------------------------------------------------------
# (OPTIONAL) Google Pub/Sub for push-based Gmail notifications
# -------------------------------------------------------------------------
# Initially, TidyMail uses @Scheduled polling to sync new mail. This is
# FINE for a personal-use app and drastically simpler than the push path.
# The vars below are ONLY needed if you later add push notifications
# (Pub/Sub topic + Gmail watch() API). Until then, LEAVE THEM COMMENTED.
#
# How to set up (future reference):
#   - Create Pub/Sub topic + subscription in the same GCP project.
#   - Grant publish rights to gmail-api-push@system.gserviceaccount.com.
#   - Call users.watch from the backend to register the topic.
#
# GOOGLE_PUBSUB_TOPIC_NAME=projects/your-project-id/topics/gmail-watch
# GOOGLE_PUBSUB_VERIFICATION_TOKEN=  # openssl rand -hex 32

# =========================================================================
# 4. MICROSOFT OAUTH (Outlook / Office 365)
# =========================================================================
# HOW TO GET THESE VALUES:
#   1. Go to https://portal.azure.com/ → Microsoft Entra ID → App registrations.
#   2. New registration:
#        - Name = TidyMail
#        - Supported account types = "Accounts in any organizational
#          directory and personal Microsoft accounts (common)"
#          (this lets @outlook.com, @hotmail.com, and work/school accounts log in)
#   3. Redirect URI → Type: Web → Value:
#        ${APP_BASE_URL}/login/oauth2/code/microsoft
#      (e.g. http://localhost:8080/login/oauth2/code/microsoft)
#   4. Register.
#   5. Copy "Application (client) ID" → MICROSOFT_CLIENT_ID below.
#   6. Copy "Directory (tenant) ID" → MICROSOFT_TENANT_ID below (OPTIONAL;
#      leave EMPTY for "common" endpoint = personal + work/school accounts).
#   7. Certificates & secrets → New client secret → copy the "Value"
#      (NOT the Secret ID) into MICROSOFT_CLIENT_SECRET below.
#
# NOTE: Scopes (openid, profile, email, User.Read, Mail.ReadWrite, Mail.Send,
# MailboxSettings.ReadWrite, offline_access) are defined statically in
# application.properties, not here.

# Azure Application (client) ID — a UUID like 123e4567-e89b-12d3-a456-426614174000
MICROSOFT_CLIENT_ID=your-azure-application-client-id

# Azure Client Secret VALUE (shown ONCE during creation). Not the "Secret ID".
MICROSOFT_CLIENT_SECRET=your-azure-client-secret-value

# Azure Tenant (directory) ID.
#   LEAVE EMPTY = uses the "common" endpoint, which accepts:
#     - personal Microsoft accounts (@outlook.com, @hotmail.com, @live.com)
#     - any work/school Azure AD account
#   Set to a specific UUID = restrict login to ONE organization only.
MICROSOFT_TENANT_ID=

# (Optional / future) Random state value used to verify Microsoft Graph
# change-notification webhook requests. Not used by polling sync.
# Generate: openssl rand -hex 32
MICROSOFT_WEBHOOK_CLIENT_STATE=

# =========================================================================
# 5. SPRING SECURITY OAUTH2 CLIENT MAPPING (notes, no variables here)
# =========================================================================
# Spring Security's OAuth2 properties live in application.properties and
# REFERENCE the values above via ${...} placeholders.
#
# The mapping looks like this (already in application.properties — do NOT
# duplicate here, keep only the secrets in .env):
#
#   spring.security.oauth2.client.registration.google.client-id=${GOOGLE_CLIENT_ID}
#   spring.security.oauth2.client.registration.google.client-secret=${GOOGLE_CLIENT_SECRET}
#   spring.security.oauth2.client.registration.google.scope=openid,profile,email,https://www.googleapis.com/auth/gmail.modify,offline_access
#   spring.security.oauth2.client.registration.google.redirect-uri={baseUrl}/login/oauth2/code/{registrationId}
#
#   spring.security.oauth2.client.registration.microsoft.client-id=${MICROSOFT_CLIENT_ID}
#   spring.security.oauth2.client.registration.microsoft.client-secret=${MICROSOFT_CLIENT_SECRET}
#   spring.security.oauth2.client.provider.microsoft.issuer-uri=https://login.microsoftonline.com/${MICROSOFT_TENANT_ID:common}/v2.0
#   spring.security.oauth2.client.registration.microsoft.scope=openid,profile,email,User.Read,Mail.ReadWrite,Mail.Send,MailboxSettings.ReadWrite,offline_access
#   spring.security.oauth2.client.registration.microsoft.redirect-uri={baseUrl}/login/oauth2/code/{registrationId}

# =========================================================================
# 6. ENCRYPTION (for OAuth refresh tokens stored in the database)
# =========================================================================
# OAuth refresh tokens are written to the `user_account` table and MUST be
# encrypted at rest. TidyMail uses AES/GCM with a 256-bit key and a fixed
# salt. Generate BOTH with the commands below.
#
# WARNING — READ THIS:
#   If you lose TOKEN_ENCRYPT_SECRET or TOKEN_ENCRYPT_SALT, every linked
#   Gmail/Outlook account becomes unusable. Users will have to sign in
#   again to get a new refresh token. BACK THESE UP in a password manager
#   BEFORE running the app in production, and NEVER change them on an
#   existing database (there is no re-key migration path in the personal
#   use build — add one yourself if you need rotation later).
#
# Generate:
#   openssl rand -hex 32   → 256-bit AES key
#   openssl rand -hex 16   → 128-bit salt
TOKEN_ENCRYPT_SECRET=
TOKEN_ENCRYPT_SALT=

# =========================================================================
# 7. SESSION & CSRF SECRETS
# =========================================================================

# Servlet session timeout. Default is 24 hours to match the InboxTriage
# D2 "session-scope triage" model — a user can spend all day triaging
# without being logged out. Increase for a family Kiosk, decrease for
# shared-host security paranoia.
SERVER_SERVLET_SESSION_TIMEOUT=86400s

# Cron expression for cleaning up expired SPRING_SESSION rows via JDBC
# session store. Default: 04:00 local server time daily.
SPRING_SESSION_JDBC_CLEANUP_CRON="0 0 4 * * *"

# (Optional) Secret key used when persisting CSRF tokens to a custom store
# (e.g. signed double-submit cookies). Leave blank to use Spring's default
# per-session in-memory CsrfTokenRepository.
# Generate: openssl rand -hex 32
CSRF_TOKEN_SECRET=

# General-purpose signing key for internal tokens (e.g. signed action UUIDs,
# one-shot email-confirm links, email-OTP fallback). Must be set in prod;
# can be blank in dev (uses a hardcoded dev-only key — flagged in logs).
# Generate: openssl rand -hex 32
AUTH_SECRET=

# =========================================================================
# 8. INTERNAL API & CRON SECURITY
# =========================================================================
# TidyMail exposes protected job endpoints under /jobs/... and /internal/...
# These are NOT accessible via normal browser OAuth — they require a bearer
# API key header. Used by: cloudflared-runbook cron, your own CI runner, etc.
#
# Pattern inherited from inbox-zero reference:
#   - If CRON_SECRET is NOT set in the prod profile, internal cron routes
#     are DISABLED entirely as a safety measure.

# Required header: X-Internal-API-Key: <value>
# Generate: openssl rand -hex 32
INTERNAL_API_KEY=

# Legacy / alias env var — some hosted cron runners use the CRON_SECRET
# name. If set, it MUST equal INTERNAL_API_KEY or internal routes refuse.
# For simplicity, just set both vars to the SAME value.
CRON_SECRET=

# =========================================================================
# 9. PRIVACY & DATA RETENTION
# =========================================================================
# TidyMail operates under a strict METADATA-ONLY model (no email bodies
# ever fetched or stored). These settings lock that down.

# After this many seconds, wipe orphaned session rows from DB even if
# Spring's own cleanup didn't catch them (belt-and-suspenders).
# Default: 24 hours (same as session timeout).
DATA_RETENTION_SESSION_TTL_SECONDS=86400

# On explicit sign-out, DELETE that user's rows from: processed_email,
# triage_decision, sync_cursor, user_account (after revoking tokens).
# KEEP true. Setting to false is a privacy bug and will be logged as a
# warning at startup.
DATA_RETENTION_DELETE_USER_DATA_ON_SIGNOUT=true

# Safety lock. When TRUE, the sync layer refuses to request the Gmail
# "raw" or "full" format or the Outlook $value body endpoint — it only
# ever asks for METADATA. If set to FALSE, the app logs a big red warning
# at startup but still starts (so you can develop a body-feature branch).
PRIVACY_METADATA_FORMAT_ENFORCED=true

# =========================================================================
# 10. SYNC / JOBS BEHAVIOR
# =========================================================================
# Tunables for the @Scheduled sync jobs. Values tuned for a personal-use
# app with 1–5 accounts. Increase concurrency only if you have >50k emails
# AND understand the Google/Microsoft rate limits.

# Refresh access tokens this many seconds before expiry. Valid range: 0–3600.
OAUTH_REFRESH_EXPIRY_SKEW_SECONDS=60

# First-run render batch. Valid range: 100–250; default 200.
SYNC_INITIAL_PAGE_SIZE=200

# Optional unique-message safety ceiling per account. Zero or absent means
# unlimited. This bounds message count only; it is not a mailbox-size quota.
SYNC_MAX_MESSAGES_PER_ACCOUNT=0

# Gmail messages.list page size for historical backfill. Gmail permits at
# most 500 results per page.
SYNC_GMAIL_BACKFILL_PAGE_SIZE=500

# Maximum messages inspected by one bounded repair pass.
SYNC_GMAIL_REPAIR_LIMIT=100

# Gmail request permits reserved for freshness work. Must be at least 1 and
# lower than SYNC_GMAIL_API_CONCURRENCY so backfill retains capacity.
SYNC_GMAIL_FRESHNESS_RESERVED_CAPACITY=1

# Freshness scheduling and independently bounded worker lanes.
SYNC_FRESHNESS_CYCLE_MS=300000
SYNC_FRESHNESS_EXECUTOR_THREADS=2
SYNC_FRESHNESS_EXECUTOR_QUEUE_CAPACITY=100
SYNC_BACKFILL_EXECUTOR_THREADS=2
SYNC_BACKFILL_EXECUTOR_QUEUE_CAPACITY=100

# Durable PostgreSQL lane ownership expiry. Valid range: 10-3600 seconds.
SYNC_LANE_LEASE_SECONDS=60

# How often we recompute per-sender aggregates (# of emails, oldest,
# newest, unread count) to drive the Sender Stats view. In milliseconds.
# Default: every 30 minutes.
SYNC_SENDER_STATS_INTERVAL_MS=1800000

# Gmail API concurrent requests per account (per sync run). InboxTriage
# D3 decision: 5 parallel users.batchGet / messages.list calls.
SYNC_GMAIL_API_CONCURRENCY=5

# Small delay (ms) between Gmail batch requests to stay well under
# Google's per-user 250 req/s quota (D3 decision).
SYNC_GMAIL_API_BATCH_DELAY_MS=100

# =========================================================================
# 11. SAFETY GUARDS
# =========================================================================
# Extra checks before destructive actions (delete, archive, mark-read in bulk).

# If a single triage action would affect MORE than N emails, the UI
# requires an extra confirmation step: the user must re-type the count
# shown on screen (and optionally solve a simple math puzzle) before the
# action is accepted.
SAFETY_DELETE_CONFIRM_THRESHOLD=100

# Absolute ceiling. No single action request may describe more than this
# many message IDs; anything larger is split server-side into chunks with
# separate undo-tokens.
SAFETY_ACTION_MAX_BATCH_SIZE=500

# How long an action stays in the "Undo" queue (in seconds). After this
# window, the operation is considered committed and undo is refused.
# Default: 10 minutes.
SAFETY_UNDO_WINDOW_SECONDS=600

# =========================================================================
# 12. SIGNUP / ALLOWLIST (when opening to friends later)
# =========================================================================
# Out of the box, TidyMail allows ANYONE with a valid Google or Microsoft
# OAuth login to create an account. That is fine on localhost, but a bad
# idea if you ever put it on the public internet. Set one or both of these
# BEFORE sharing a Cloudflare URL.

# Comma-separated allowlist of exact email addresses. If NON-EMPTY, only
# these addresses may sign in. OAuth logins from any other address are
# rejected with a friendly "not on the list" error page.
#
# Example:
#   AUTH_ALLOWED_EMAILS=me@gmail.com,spouse@outlook.com,kid@family.org
AUTH_ALLOWED_EMAILS=

# Comma-separated allowlist of email DOMAINS. Any OAuth login whose email
# ends with one of these domains is accepted. Useful for a family org
# domain or a small company. Applied AFTER AUTH_ALLOWED_EMAILS (i.e. a
# user passes if EITHER list matches).
#
# Example:
#   AUTH_ALLOWED_EMAIL_DOMAINS=family.org,mycompany.com
AUTH_ALLOWED_EMAIL_DOMAINS=

# =========================================================================
# 13. CLOUDFLARE TUNNEL (setup notes — NOT read by the Java app)
# =========================================================================
# The variables below are NOT consumed by Spring Boot. They're here as a
# mnemonic / copy-paste reference for configuring `cloudflared` on the
# host machine that runs TidyMail.
#
# Typical setup:
#   1. Install cloudflared: https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/get-started/create-local-tunnel/
#   2. Login:   cloudflared tunnel login
#   3. Create:  cloudflared tunnel create tidymail
#   4. Route:   cloudflared tunnel route dns tidymail tidymail.yourdomain.com
#   5. Write ~/.cloudflared/config.yml with the values below.
#   6. Run:     cloudflared tunnel run tidymail
#
# Example ~/.cloudflared/config.yml:
#   tunnel: <TUNNEL_ID_FROM_STEP_3>
#   credentials-file: /home/you/.cloudflared/<TUNNEL_ID>.json
#   ingress:
#     - hostname: tidymail.yourdomain.com
#       service: http://localhost:8080
#     - service: http_status:404
#
# CRITICAL REMINDER — OAUTH REDIRECT URIS:
#   When running behind Cloudflare Tunnel, your APP_BASE_URL becomes the
#   HTTPS URL (e.g. https://tidymail.yourdomain.com). You MUST go back to
#   both OAuth dashboards and UPDATE the Authorized Redirect URIs:
#
#   Google Cloud Console → Credentials → OAuth 2.0 Client IDs → Edit:
#     Authorized redirect URIs = https://tidymail.yourdomain.com/login/oauth2/code/google
#     (you can keep the localhost entry alongside it for local dev)
#
#   Azure Portal → App Registration → Authentication → Web → Redirect URIs:
#     = https://tidymail.yourdomain.com/login/oauth2/code/microsoft
#     (again, localhost can coexist)

# (Placeholder — not read by app; fill these in on the HOST machine's cloudflared config)
CLOUDFLARED_TUNNEL_ID=your-tunnel-uuid
CLOUDFLARED_PUBLIC_HOSTNAME=tidymail.yourdomain.com
CLOUDFLARED_BACKEND_URL=http://localhost:8080

# =========================================================================
# 14. OPTIONAL JEV CLASSIFICATION VIA OPENROUTER
# =========================================================================
# User-authorized exception to the original non-AI scope. No local model required.
# Add a dedicated, spending-limited OpenRouter key. Never commit it or paste it in chat.
# Leave blank to disable. Restart after changing .env, then choose Classify mail.
OPENROUTER_API_KEY=
# Fixed model: typesafe/jev-1.14. Requests require ZDR, TypeSafe only, no fallback,
# no response caching. Never sends bodies, attachments, recipients or OAuth tokens.
# Before using: disable Input & Output Logging, OpenRouter Use of Inputs/Outputs,
# Broadcast/external observability; enable ZDR for All other models in OpenRouter.
# This app cannot inspect or change those account settings for you.
# Usage metadata and legal screening exceptions remain. See docs/JEV-CLASSIFICATION.md.

# =========================================================================
# 15. BILLING & THIRD-PARTY INTEGRATIONS — INTENTIONALLY OMITTED
# =========================================================================
# All excluded for the "personal-use-first" phase. None of the following
# are wired up in code, and their keys are intentionally absent:
#
#   PAYMENTS: Stripe, Lemon Squeezy, Paddle, Gumroad
#   NOTIFICATIONS / CHAT: Slack, Teams, Telegram, Discord, WhatsApp
#   CALENDARS: Not a separate key yet (Outlook/Google calendars come
#              through the same OAuth token already, but sync is disabled
#              by design in v1)
#   ERROR / ANALYTICS: Sentry, PostHog, Plausible, LogRocket, Datadog
#   STORAGE: S3/R2/GCS for attachments (not fetched, per privacy model)
#
# Add only when opening to other users AND there is a concrete budget/ops
# owner. Do NOT sneak keys in "just in case".
