{
  "version": "1.0",
  "projectName": "TidyMail",
  "projectRoot": "/Users/bytedance/Documents/trae_projects/TidyMail",
  "workflow": {
    "autoAdvance": true,
    "autoPlan": true,
    "autoExecute": true,
    "autoVerify": true,
    "autoAudit": true,
    "requireApprovalBeforeExecution": false,
    "requireApprovalBeforePhaseAdvance": true,
    "requireApprovalBeforeSpecComplete": true,
    "research": true,
    "nyquist_validation": true,
    "pattern_mapper": true,
    "ui_phase": true,
    "ui_safety_gate": true,
    "ai_integration_phase": false,
    "tdd_mode": false,
    "code_review": true,
    "ui_review": true,
    "plan_check": true,
    "verifier": true,
    "auto_advance": true,
    "skip_discuss": true,
    "use_worktrees": true,
    "research_before_questions": true,
    "code_review_depth": "deep",
    "_auto_chain_active": false
  },
  "uiProfile": {
    "framework": "thymeleaf-htmx",
    "styling": "picocss-or-tailwind-tbd",
    "mode": "server-rendered",
    "responsive": true,
    "mobileFirst": false
  },
  "aiUsage": {
    "aiEnabled": false,
    "llmMatrix": "excluded-non-goal",
    "note": "Per docs/DECISIONS.md section 2: ALL AI/LLM features are deliberately removed from scope. This is a non-AI, deterministic cleanup tool only."
  },
  "testing": {
    "framework": "junit-jupiter-spring-boot-test",
    "e2e": "tbd-selenium-or-playwright",
    "verifyPerPhase": true
  },
  "deployment": {
    "target": "jar-behind-cloudflare-tunnel",
    "hosting": "vps-or-local-machine",
    "edge": "cloudflare-tunnel-for-https-waf-dns",
    "note": "Java/Spring Boot cannot run on Cloudflare Workers (V8/Wasm). Cloudflare network sits IN FRONT of the JVM origin via cloudflared tunnel. No open ports, no self-managed SSL."
  },
  "auth": {
    "providers": [
      "google",
      "microsoft"
    ],
    "mechanism": "spring-security-oauth2-client",
    "tokenStorage": "jpa-postgres-encrypted-refresh-tokens",
    "note": "OAuth redirect URIs point at the Cloudflare HTTPS URL. Both providers coexist; login page shows buttons only when env vars are non-dummy."
  },
  "mailProviders": {
    "gmail": {
      "sdk": "google-api-services-gmail-v1",
      "scopes": "https://www.googleapis.com/auth/gmail.modify openid profile email offline_access",
      "dataFormat": "METADATA-only (headers+labels+snippet, never full body)"
    },
    "outlook": {
      "sdk": "microsoft-graph-java-sdk + azure-identity",
      "scopes": "Mail.ReadWrite Mail.Send MailboxSettings.ReadWrite User.Read openid profile email offline_access",
      "tenantId": "empty=common (personal + work/school accounts)"
    }
  },
  "privacy": {
    "bodyAccess": "never-by-default",
    "dataRetention": "user-owned-db; sign-out-wipes-user-scoped-rows; ttl-cron-for-orphans",
    "auditLog": "append-only-user_actions-for-undo",
    "encryption": "refresh-tokens-encrypted-at-rest"
  },
  "logging": {
    "contentLogs": "never-log-email-subject-body-snippet",
    "anonymizedLogs": "counts-only-ids-only-no-content"
  },
  "intel": {
    "enabled": false
  },
  "graphify": {
    "enabled": false
  },
  "model_profile": "inherit",
  "commit_docs": true,
  "plan_review": {
    "source_grounding": true
  },
  "git": {
    "branching_strategy": "none",
    "create_tag": true
  },
  "hooks": {
    "context_warnings": true
  }
}
